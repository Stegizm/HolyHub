# Docker ignore — these files won't be included in the Docker build context
# reducing build time and image size.

# Dependencies
node_modules
.pnp
.pnp.*

# Build outputs
.next
out
dist
build

# Environment (will be passed at runtime)
.env
.env.local
.env.*.local
.env.example

# Logs
*.log
dev.log
server.log

# Git
.git
.gitignore

# Documentation (not needed in container)
README.md
RELEASING.md
CHANGELOG.md
CONTRIBUTING.md
LICENSE
docs/

# CI/CD
.github
.zscripts

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Database (volume mount edilecek)
db
*.db
*.db-journal

# Skills & examples
skills
examples
download
scripts
